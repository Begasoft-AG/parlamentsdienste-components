{
    "extends": "../../tsconfig.web.json",
    "compilerOptions": {
        "allowUnreachableCode": false,
        "declaration": false,
        "noImplicitReturns": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "strict": false,
        "jsx": "react",
        "jsxFactory": "h",
        "jsxFragmentFactory": "h.Fragment"
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}
