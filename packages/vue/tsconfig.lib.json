{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["vite/client"],
        "allowUnreachableCode": false,
        "declaration": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "dist",
        "removeComments": false,
        "sourceMap": true,
        "jsx": "react"
    },
    "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
