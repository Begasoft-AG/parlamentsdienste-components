{
    "name": "@parlamentsdienste/source",
    "version": "4.0.2",
    "license": "MIT",
    "description": "Component Library for Swiss Parliamentary Services",
    "packageManager": "pnpm@11.13.0",
    "scripts": {
        "build:angular-output-target": "pnpm --filter @parlamentsdienste/angular-output-target run build",
        "build:core": "pnpm --filter @parlamentsdienste/pdcomponents-core run build",
        "build:angular": "pnpm --filter @parlamentsdienste/pdcomponents-angular run build",
        "build:react": "pnpm --filter @parlamentsdienste/pdcomponents-react run build",
        "build:vue": "pnpm --filter @parlamentsdienste/pdcomponents-vue run build",
        "build:storybook": "pnpm --filter docs run build",
        "build:all": "pnpm run build:angular-output-target && pnpm run build:core && pnpm run build:angular && pnpm run build:react && pnpm run build:vue && pnpm run build:storybook",
        "start:core": "pnpm --filter @parlamentsdienste/pdcomponents-core run start",
        "start:storybook": "pnpm --filter docs run start",
        "start:angular": "pnpm --filter angular-test run serve",
        "start:react": "pnpm --filter react-test run dev",
        "start:vue": "pnpm --filter vue-test run dev",
        "test:core": "pnpm --filter @parlamentsdienste/pdcomponents-core run test",
        "test:angular": "pnpm --filter angular-test run e2e",
        "test:react": "pnpm --filter react-test run e2e",
        "test:vue": "pnpm --filter vue-test run e2e",
        "injectOpSecrets:registry": "op inject -i ./deployment/registry-secret.template -o ./deployment/registry-secret.yaml && echo 'Secrets injected!'",
        "update-versions": "npx tsx tools/update-versions.ts",
        "clean:dist": "rm -rf packages/core/dist packages/vue/dist packages/angular/dist packages/react/dist libs/angular-output-target/dist docs/storybook-static",
        "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
        "pack:core": "cd packages/core && npm pack && cd ../..",
        "pack:angular": "cd packages/angular/dist && npm pack && cd ../../..",
        "pack:react": "cd packages/react/dist && npm pack && cd ../../..",
        "pack:vue": "cd packages/vue/dist && npm pack && cd ../../..",
        "pack:all": "npm run pack:core && npm run pack:angular && npm run pack:react && npm run pack:vue",
        "publish:core": "cd packages/core && npm publish && cd ../..",
        "publish:angular": "cd packages/angular/dist && npm publish && cd ../../..",
        "publish:react": "cd packages/react/dist && npm publish && cd ../../..",
        "publish:vue": "cd packages/vue/dist && npm publish && cd ../../..",
        "publish:all": "npm run publish:core && npm run publish:angular && npm run publish:react && npm run publish:vue"
    },
    "private": true,
    "engines": {
        "node": ">=24.15.0 <25",
        "pnpm": "11.13.0"
    },
    "workspaces": [
        "apps/*",
        "libs/*",
        "packages/*",
        "docs"
    ],
    "devDependencies": {
        "@babel/core": "^7.14.5",
        "@playwright/test": "^1.36.0",
        "@stencil/core": "^4.43.5",
        "@swc/core": "~1.5.7",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.0.0",
        "autoprefixer": "^10.4.0",
        "eslint": "^9.8.0",
        "jiti": "2.4.2",
        "postcss": "^8.4.5",
        "postcss-url": "~10.1.3",
        "tslib": "^2.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.64.0",
        "vite": "^6.0.0",
        "vite-plugin-dts": "~4.5.0",
        "vite-plugin-static-copy": "^3.1.0",
        "vite-tsconfig-paths": "^6.1.1",
        "@parlamentsdienste/pdcomponents-angular": "workspace:*",
        "@parlamentsdienste/pdcomponents-core": "workspace:*"
    }
}
